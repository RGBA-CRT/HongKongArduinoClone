' ウィンドウ ハンドル: hFlashWnd

' TODO: この位置にグローバルな変数、構造体、定数、関数を定義します。


'-----------------------------------------------------------------------------
' ウィンドウメッセージを処理するためのコールバック関数

Function FlashWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
	' TODO: この位置にウィンドウメッセージを処理するためのコードを記述します。

	' イベントプロシージャの呼び出しを行います。
	FlashWndProc=EventCall_FlashWnd(hWnd,dwMsg,wParam,lParam)
End Function


'-----------------------------------------------------------------------------
' ここから下は、イベントプロシージャを記述するための領域になります。

Sub FlashWnd_open()
	if hFlashWnd = NULL Then CreateDialog(hMainWnd, "FlashWnd")
	MainWnd_Move(0, 0)
	'SFMW_bMove = FALSE
End Sub
Function FWnd(idx AS Long) AS HANDLE
	FWnd = GetDlgItem(hFlashWnd, idx)
End Function
	
	Dim cmdBank AS Byte
	Dim cmdOffset As DWOrd
	cmdBank = &H00
	cmdOffset=&H8000

Sub GenerateFlashLayoutText(layoutText AS BytePtr, mapMode AS Long, chipInfo AS *FlashChipInfo)
	Dim start AS DWord, tail AS DWord
	if mapMode = SFC_MAP_LoROM then
		start = LoROM_OFFSET_ADR
		tail = chipInfo->size*2 + start -&H8001
	Else
		start = HiROM_START_ADR
		tail = start + chipInfo->size -1
	End If
	wsprintf(layoutText, "%02x:%04x-%02x:%04x %d Mbit %s", _
		start >> 16, start And &HFFFF, _
		tail >> 16, tail And &HFFFF, _
		(chipInfo->size*8)/1024/1024, chipInfo->name)
End Sub

Sub FlashWnd_CommandButton1_Click()
	Dim mapMode AS DWord
	dim flashId AS FlashChipId
	Dim flashCmdType AS Long

	mapMode = getSelectedMapMode(FWnd(MAPPING))
	if mapMode >= SFC_MAP_TYPE__NUM then
		DBM("WARN: Please select 'Map' mode")
		mapMode = SFC_MAP_LoROM
	End If

	flashCmdType = FlashDetect(hCOM, &H8000, VarPtr(flashId))
	if flashCmdType = FlashCmdTypeNotFlash Then
		DBMf("maybe not flash detected.")
		SetDlgItemText(hFlashWnd, ComboBox1, "<not flash>")
		SetDlgItemText(hFlashWnd, FlashName, "<not flash>")
		ExitSub
	End If

	SendMessage(FWnd(ComboBox1), CB_SETCURSEL, flashCmdType, 0)

	' EditBox: FlashName
	Dim flashName AS BytePtr, chipInfo AS *FlashChipInfo
	chipInfo = GetFlashChipInfo(VarPtr(flashId))
	if chipInfo = NULL Then
		flashName = "<unknown>"
	else
		flashName = chipInfo->name
		' ListBox: Layout
		Dim layoutText[128] AS Byte
		GenerateFlashLayoutText(layoutText, mapMode, chipInfo)
		SendMessage(FWnd(ListBox1), LB_RESETCONTENT, 0, 0)
		SendMessage(FWnd(ListBox1), LB_ADDSTRING, 0, layoutText)
		SendMessage(FWnd(ListBox1), LB_ADDSTRING, 0, "todo: impl this")
	End If
	SetDlgItemText(hFlashWnd, FlashName, flashName)



	' TODO: DETECT LOROM/HIROM layout
	
	DBMf("Flash VID=%02X PID=%02X %s", flashId.vendor, flashId.product, flashName)

	Dim info AS SFC_CART_INFO
	wsprintf(info.Title, "<FLASH DETECTION MODE>", flashName)
	info.MapType = mapMode
	if chipInfo then info.RomSize = chipInfo->size
	SetCartInfo(VarPtr(info))
	
	SetWindowTextFormat(MWnd(CART_CIPS), "<Flash: %s>", flashName)

End Sub

Function getSelectedFlashCmdType() AS DWord
	Dim idx AS Long

	idx=SendMessage(FWnd(ComboBox1),CB_GETCURSEL,0,0)
	if idx<0 or idx>=FlashCmdTypeMAX Then
		idx=FlashCmdTypeMAX
	End If
	getSelectedFlashCmdType=idx AS DWord
End Function


Sub FlashWnd_CommandButton2_Click()
	Dim mapMode AS DWord	
	mapMode = getSelectedMapMode(FWnd(MAPPING))
	if mapMode >= SFC_MAP_TYPE__NUM then
		DBM(ex"Error: Please select 'Map' mode\r\n")
		MessageBeep(MB_ICONHAND)
		ExitSub
	End If

	Dim mmap As SFC_MMAP_MODEL
	GetMmapModel(mapMode, TRUE, VarPtr(mmap)) ' TODO


	Dim cmdType AS DWord
	cmdType = getSelectedFlashCmdType()
	if cmdType >= FlashCmdTypeMAX then
		DBM(ex"WriteError: Please 'Detect' your flash or select the 'Type' manually.\r\n")
		MessageBeep(MB_ICONHAND)
		ExitSub
	End If

	' todo: detect結果を覚えておいて処理する。今は1個しか対応できない

	Dim pc AS *ProgressCallBack
	pc = new_GenericProgressCallBack("FlashErase", "ms")

	DBM(ex"Start erase...")

	Dim fc AS FlashChipController

	fc.Init(hCOM, cmdType, mmap.rom.adr)
	if fc.ChipErase(pc) then
		DBM(ex"Chip Erase done!\r\n")
	Else
		DBM(ex"Chip Erase failed.\r\n")
	End If

	delete_GenericProgressCallBack(pc)
End Sub

Sub FlashWnd_Program(file AS BytePtr)
	Dim buf AS BufferClass
	Dim mapMode AS DWord	
	mapMode = getSelectedMapMode(FWnd(MAPPING))
	if mapMode >= SFC_MAP_TYPE__NUM then
		DBM(ex"Error: Please select 'Map' mode\r\n")
		MessageBeep(MB_ICONHAND)
		ExitSub
	End If

	Dim mmap As SFC_MMAP_MODEL
	GetMmapModel(mapMode, TRUE, VarPtr(mmap)) ' TODO

	Dim cmdType AS DWord
	cmdType = getSelectedFlashCmdType()
	if cmdType >= FlashCmdTypeMAX then
		DBM(ex"WriteError: Please 'Detect' your flash or select the 'Type' manually.\r\n")
		MessageBeep(MB_ICONHAND)
		ExitSub
	End If

	if LoadFileToMemory(file, VarPtr(buf)) = FALSE then
		DBM("failed to load file.")
		exitsub
	endif
	if buf.length() = 0 then
		DBM("file size is zero.")
		exitsub
	endif

	Dim pc AS *ProgressCallBack
	pc = new_GenericProgressCallBack("FlashProg", "")
	pc->Init(buf.length())
/*
	FlushCom(hCOM)
	FlashCmdInit(cmdBank, cmdOffset)
	
'	FlashWriteSoftware(VarPtr(buf), pc)
	FlashWriteHardware(cmdBank<<16 + cmdOffset, VarPtr(buf), VarPtr(mmap), pc)

	FlashCmdExit(cmdBank, cmdOffset)
	*/
	
	Dim fc AS FlashChipController
	fc.Init(hCOM, cmdType, mmap.rom.adr)
	if fc.Program(buf.ptr, buf.length(), VarPtr(mmap), pc) then
		DBM(ex"Program flash done!\r\n")
	Else
		DBM(ex"Program flash failed.\r\n")
	End If

	
	pc->Final()

	delete_GenericProgressCallBack(pc)
End Sub

Sub FlashWnd_CommandButton4_Click()
	Dim path As BytePtr

	path = LoadDialogCalloc(ex"ROMイメージファイル(*.sfc)\0*.sfc\0すべてのファイル(*.*)\0*.*\0\0", "sfc")
	If path=0 Then ExitSub
	FlashWnd_Program(path)
	free(path)
End Sub

Sub FlashWnd_CommandButton3_Click()
	FlashWnd_Program("write2.srm")
End Sub

