Sub FlashWnd_Create(ByRef CreateStruct As CREATESTRUCT)
	SendMessage(FWnd(MAPPING), CB_RESETCONTENT, 0, 0)
	Dim i as Long
	for i = 0 To SFC_MAP_TYPE__NUM-1
		SendMessage(FWnd(MAPPING), CB_ADDSTRING, 0, GetMappingString(i) As Long)
	Next i
	SetWindowText(FWnd(MAPPING), "<PLEASE SELECT MAPPING>")

	
	SendMessage(FWnd(ListBox1), LB_ADDSTRING, 0, "<SELECT MAPPING AND PRESS DETECT>" As Long)
	
	for i = 0 To FlashCmdTypeMAX-1
		Dim set AS FlashCmdSet
		GetFlashCmdSet(i, set)
		SendMessage(FWnd(ComboBox1), CB_ADDSTRING, 0, set.name As Long)
	Next i

	SetCheckBox(FWnd(CheckBox1), FALSE)
	FlashWnd_CheckBox1_Click()

End Sub

