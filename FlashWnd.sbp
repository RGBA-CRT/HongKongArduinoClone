'-----------------------------------------------------------------------------
' ウィンドウメッセージを処理するためのコールバック関数

Function FlashWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
	' TODO: この位置にウィンドウメッセージを処理するためのコードを記述します。

	' イベントプロシージャの呼び出しを行います。
	FlashWndProc=EventCall_FlashWnd(hWnd,dwMsg,wParam,lParam)
End Function


'-----------------------------------------------------------------------------
' ここから下は、イベントプロシージャを記述するための領域になります。

Sub FlashWnd_open()
	if hFlashWnd = NULL Then CreateDialog(hMainWnd, "FlashWnd")
	MainWnd_Move(0, 0)
	'SFMW_bMove = FALSE
End Sub
	
	Dim cmdBank AS Byte
	Dim cmdOffset As DWOrd
	cmdBank = &H00
	cmdOffset=&H8000

Type IdTextMap
	id AS DWord
	name AS BytePtr
End Type

Const FLASH_ID_TABLE_MAX = 25
Dim FlashIdTable[FLASH_ID_TABLE_MAX] = [
	[&HC2A4, "MX29F040"   ],
	[&HC2D5, "MX29F080"   ], ' ByteProgram: 7-210us, ChipErase: 8-64sec
	[&HC249, "MX29LV160DB"],
	[&HC2C4, "MX29LV160DT"],
	[&HC2A8, "MX29LV320DB"],
	[&HC2A7, "MX29LV320DT"],
	[&HC2CB, "MX29LV640DB"],
	[&HC2C9, "MX29LV640DT"],
	[&HC2FA, "MX29F1610A" ], ' NintendoPower
	[&HC2FB, "MX29F1610B" ], ' NintendoPower
	[&HC2F7, "MX29F1611"  ], ' NintendoPower
	[&HC26B, "MX29F1615"  ], ' NintendoPower
	[&HC2F3, "MX29F1601MC"], ' NintendoPower
	[&H01A4, "AM29F040"   ], ' ByteProgram: 7-300us, 8-64sec
	[&H01D5, "AM29F080"   ],
	[&HBFB5, "SST39SF010A"],
	[&HBFB5, "SST39SF020A"],
	[&HBFB7, "SST39SF040" ], ' ByteProgram: 14us, ChipErase: 0.1sec
	[&H04A4, "MBM29F040"  ], ' ByteProgram: 150us, ChipErase: 4.2-10sec
	[&H04D5, "MBM29F080"  ],
	[&H0423, "MBM29F400TC"],
	[&H04AB, "MBM29F400BC"],
	[&H0458, "MBM29F800BA"],
	[&H04D6, "MBM29F800TA"],
] As IdTextMap

Function GetFlashName(id AS Word) As BytePtr
	Dim i As Long
	GetFlashName = "<unknown>"
	for i = 0 To FLASH_ID_TABLE_MAX-1
		if FlashIdTable[i].id = id Then
			GetFlashName = FlashIdTable[i].name
			ExitFor
		End If
	Next

End Function

Sub FlashWnd_CommandButton1_Click()
	Dim preId[4] As Byte
	SendControl(hCOM, CBUS_OE OR CBUS_ROMSEL OR CBUS_WE)
	SendControl(hCOM, CBUS_OE OR CBUS_WE OR CBUS_RST)

	ReadROM(hCOM,VarPtr(preId),cmdBank,cmdOffset,4,FALSE)
	PrintPtr(ex"preid\n")
	Dump(VarPtr(preId),4,0)

	' Reset Flash
	SetCartRegister(cmdBank, cmdOffset + &H0000, &HF0, FALSE)
	' ReadID
	SetCartRegister(cmdBank, cmdOffset + &H0555, &HAA, FALSE)
	SetCartRegister(cmdBank, cmdOffset + &H02AA, &H55, FALSE)
	SetCartRegister(cmdBank, cmdOffset + &H0555, &H90, FALSE)

	Dim flashId[16] As Byte
	ReadROM(hCOM,VarPtr(flashId),cmdBank,cmdOffset,16,FALSE)
	Dump(VarPtr(flashId),16,0)

	Dim flashName AS BytePtr
	flashName = GetFlashName(ChangeEndianWord(GetWord(flashId)))
	SetDlgItemText(hFlashWnd, FlashName, flashName)
	
	' Reset Flash
	SetCartRegister(cmdBank, cmdOffset + &H0000, &HF0, FALSE)
	SendControl(hCOM, CBUS_DEFAULT)

	' TODO: DETECT LOROM/HIROM layout
	
	if GetDWord(flashId) = GetDWord(preId) Then
		DBMf("maybe not flash detected.")
	endif
	DBMf("Flash VID=%02X PID=%02X %s", flashId[0], flashId[1], flashName)
End Sub

