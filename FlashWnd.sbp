'-----------------------------------------------------------------------------
' ウィンドウメッセージを処理するためのコールバック関数

Function FlashWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
	' TODO: この位置にウィンドウメッセージを処理するためのコードを記述します。

	' イベントプロシージャの呼び出しを行います。
	FlashWndProc=EventCall_FlashWnd(hWnd,dwMsg,wParam,lParam)
End Function


'-----------------------------------------------------------------------------
' ここから下は、イベントプロシージャを記述するための領域になります。

Sub FlashWnd_open()
	if hFlashWnd = NULL Then CreateDialog(hMainWnd, "FlashWnd")
	MainWnd_Move(0, 0)
	'SFMW_bMove = FALSE
End Sub
	
	Dim cmdBank AS Byte
	Dim cmdOffset As DWOrd
	cmdBank = &H00
	cmdOffset=&H8000

Type FlashChipInfo
	id AS DWord
	name AS BytePtr
	size AS DWord
End Type

Const FLASH_ID_TABLE_MAX = 25
Const MBIT(x) = (x * &H20000)
Dim FlashChipInfoTable[FLASH_ID_TABLE_MAX] = [
	[ &HC2A4, "MX29F040"   , MBIT( 4) ],
	[ &HC2D5, "MX29F080"   , MBIT( 8) ], ' ByteProgram: 7-210us, ChipErase: 8-64sec
	[ &HC249, "MX29LV160DB", MBIT(16) ],
	[ &HC2C4, "MX29LV160DT", MBIT(16) ],
	[ &HC2A8, "MX29LV320DB", MBIT(32) ],
	[ &HC2A7, "MX29LV320DT", MBIT(32) ],
	[ &HC2CB, "MX29LV640DB", MBIT(64) ],
	[ &HC2C9, "MX29LV640DT", MBIT(64) ],
	[ &HC2FA, "MX29F1610A" , MBIT(16) ], ' NintendoPower
	[ &HC2FB, "MX29F1610B" , MBIT(16) ], ' NintendoPower
	[ &HC2F7, "MX29F1611"  , MBIT(16) ], ' NintendoPower
	[ &HC26B, "MX29F1615"  , MBIT(16) ], ' NintendoPower
	[ &HC2F3, "MX29F1601MC", MBIT(16) ], ' NintendoPower
	[ &H01A4, "AM29F040"   , MBIT( 4) ], ' ByteProgram: 7-300us, 8-64sec
	[ &H01D5, "AM29F080"   , MBIT( 8) ],
	[ &HBFB5, "SST39SF010A", MBIT( 1) ],
	[ &HBFB5, "SST39SF020A", MBIT( 2) ],
	[ &HBFB7, "SST39SF040" , MBIT( 4) ], ' ByteProgram: 14us, ChipErase: 0.1sec
	[ &H04A4, "MBM29F040"  , MBIT( 4) ], ' ByteProgram: 150us, ChipErase: 4.2-10sec
	[ &H04D5, "MBM29F080"  , MBIT( 8) ],
	[ &H0423, "MBM29F400TC", MBIT( 4) ],
	[ &H04AB, "MBM29F400BC", MBIT( 4) ],
	[ &H0458, "MBM29F800BA", MBIT( 8) ],
	[ &H04D6, "MBM29F800TA", MBIT( 8) ],
] As FlashChipInfo

Function GetFlashName(id AS Word) As BytePtr
	Dim i As Long
	GetFlashName = "<unknown>"
	for i = 0 To FLASH_ID_TABLE_MAX-1
		if FlashChipInfoTable[i].id = id Then
			GetFlashName = FlashChipInfoTable[i].name
			ExitFor
		End If
	Next

End Function
Function GetFlashChipInfo(id AS Word) As *FlashChipInfo
	Dim i As Long
	GetFlashChipInfo = NULL
	for i = 0 To FLASH_ID_TABLE_MAX-1
		if FlashChipInfoTable[i].id = id Then
			GetFlashChipInfo = VarPtr(FlashChipInfoTable[i])
			ExitFor
		End If
	Next

End Function

Sub FlashWnd_CommandButton1_Click()
	Dim preId[4] As Byte

	ReadROM(hCOM,VarPtr(preId),cmdBank,cmdOffset,4,FALSE)
	PrintPtr(ex"preid\n")
	Dump(VarPtr(preId),4,0)


	FlashCmdInit(cmdBank, cmdOffset)
	
	' ReadID
	SetCartRegister(cmdBank, cmdOffset + &H0555, &HAA, FALSE)
	SetCartRegister(cmdBank, cmdOffset + &H02AA, &H55, FALSE)
	SetCartRegister(cmdBank, cmdOffset + &H0555, &H90, FALSE)

	Dim flashId[16] As Byte
	ReadROM(hCOM,VarPtr(flashId),cmdBank,cmdOffset,16,FALSE)
	Dump(VarPtr(flashId),16,0)

	Dim flashName AS BytePtr, chipInfo AS *FlashChipInfo
	chipInfo = GetFlashChipInfo(ChangeEndianWord(GetWord(flashId)))
	if chipInfo = NULL Then
		flashName = "<unknown>"
	else
		flashName = chipInfo->name
	End If

	SetDlgItemText(hFlashWnd, FlashName, flashName)
	
	FlashCmdExit(cmdBank, cmdOffset)	

	' TODO: DETECT LOROM/HIROM layout
	
	if GetDWord(flashId) = GetDWord(preId) Then
		DBMf("maybe not flash detected.")
	endif
	DBMf("Flash VID=%02X PID=%02X %s", flashId[0], flashId[1], flashName)

	Dim info AS SFC_CART_INFO
	wsprintf(info.Title, "<FLASH DETECTION MODE>", flashName)
	info.MapType = SFC_MAP_LoROM
	if chipInfo then info.RomSize = chipInfo->size
	SetCartInfo(VarPtr(info))
	
	SetWindowTextFormat(MWnd(CART_CIPS), "<Flash: %s>", flashName)

End Sub

Sub FlashWnd_Static1_Click()

End Sub

Sub FlashWnd_CheckBox1_Click()

End Sub

' TODO write pulse length::: 100nsは確保したい
Dim PollInterval=32 AS DWord
Function FlashWaitOperation(offset As DWord, expect AS Byte, timeout_ms As DWord) AS BOOL
	Dim i as Long, start AS DWord
	start = GetTickCount()
	Do
		Dim poll AS Byte
'		SendControl(hCOM, CBUS_OE OR CBUS_WE OR CBUS_RST)
'		SendControl(hCOM, CBUS_WE OR CBUS_RST)

		ReadROM(hCOM, VarPtr(poll), 0, offset, 1, FALSE)
		printf(ex"[FLASH OPERATION POLLING] value=%02X, expected=%02X, invert=%d, toggles=%d,%d, DQ5=%d, DQ3=%d, dur=%dms\n", _
			poll, expect, _
			(poll>>7) And 1, (poll>>6) And 1, (poll>>2) And 1, (poll>>5) And 1, (poll>>3) And 1, _
			GetTickCount() - start)

'		SendControl(hCOM, CBUS_OE OR CBUS_WE OR CBUS_RST)		

		if poll = expect then
			FlashWaitOperation = TRUE
			ExitDo
		End If
		if (GetTickCount() - start) > timeout_ms then
			ExitDo
		End If
		PumpMessage()
		Sleep(PollInterval)
		i++
	Loop

End Function

Function FlashWaitOperationHW(expect AS Long, timeout_ms As DWord) AS BOOL
	Dim i as Long, start AS DWord
	start = GetTickCount()
	Do
		Dim poll AS Byte
		poll = DatabusRead(hCOM)
		printf(ex"[FLASH OPERATION POLLING] value=%02X, expected=%02X, invert=%d, toggles=%d,%d, DQ5_Fail=%d, DQ3=%d, dur=%dms\n", _
			poll, expect, _
			(poll>>7) And 1, (poll>>6) And 1, (poll>>2) And 1, (poll>>5) And 1, (poll>>3) And 1, _
			GetTickCount() - start)

'		SendControl(hCOM, CBUS_OE OR CBUS_WE OR CBUS_RST)		

		if expect > 0 then
			if poll = expect then
				FlashWaitOperationHW = TRUE
				ExitDo
			End If
		End If
		if (GetTickCount() - start) > timeout_ms then
			ExitDo
		End If
		PumpMessage()
		Sleep(PollInterval)
		i++
	Loop

End Function

Sub FlashCmdInit(cmdBank AS Byte, cmdOffset As Word)
	SendControl(hCOM, CBUS_OE OR CBUS_ROMSEL OR CBUS_WE)
	SendControl(hCOM, CBUS_OE OR CBUS_WE OR CBUS_RST)
	' Reset Flash
	SetCartRegister(cmdBank, cmdOffset + &H0000, &HF0, FALSE)
End Sub

Sub FlashCmdExit(cmdBank AS Byte, cmdOffset As Word)
	' Reset Flash
	SetCartRegister(cmdBank, cmdOffset + &H0000, &HF0, FALSE)
	SendControl(hCOM, CBUS_DEFAULT)
End Sub

Sub FlashCmdChipErase(cmdBank AS Byte, cmdOffset As Word)
	' ChipErase
	SetCartRegister(cmdBank, cmdOffset + &H0555, &HAA, FALSE)
	SetCartRegister(cmdBank, cmdOffset + &H02AA, &H55, FALSE)
	SetCartRegister(cmdBank, cmdOffset + &H0555, &H80, FALSE)

	SetCartRegister(cmdBank, cmdOffset + &H0555, &HAA, FALSE)
	SetCartRegister(cmdBank, cmdOffset + &H02AA, &H55, FALSE)
	SetCartRegister(cmdBank, cmdOffset + &H0555, &H10, FALSE)

	FlashWaitOperation((cmdBank << 16) OR cmdOffset, &HFF, 10000)
End Sub

Function FlashWriteSoftware(buf As *BufferClass, pc AS *DumpRomProgressCallBack)

	Dim i as DWord, start AS DWord
	start = GetTickCount()
	for i=0 To buf->length()-1
		' 
		SetCartRegister(cmdBank, cmdOffset + &H0555, &HAA, FALSE)
		SetCartRegister(cmdBank, cmdOffset + &H02AA, &H55, FALSE)
		SetCartRegister(cmdBank, cmdOffset + &H0555, &HA0, FALSE)

		SetCartRegister(i>>16, i And &HFFFF, buf->ptr[i], FALSE)

		if FlashWaitOperation(i, buf->ptr[i], 500) = FALSE then
			DBM("failed program flash.")
			Exitfor
		End If

		if (GetTickCount() - start) > 2000 then
			DBMf("programming... %Xh/%Xh", i, buf->length())
			PumpMessage()
			start = GetTickCount()
		End If
		
		pc->Step(1,i)

	Next
End Function

Sub DumperFlashConfig(ByRef elm as FlashCmdElm,adr AS Word, data as Byte)
	elm.address = adr
	elm.data = data
End Sub

Sub UpdateFlashConfig(cmdBase As DWord)
	Dim cmdOffset AS Word
	cmdOffset = (cmdBase And &HFFFF) As Word
	Dim FlashConfig16bit AS FlashConfig
	With FlashConfig16bit
		.bank = cmdBase >> 16
		DumperFlashConfig(.cmdList[0], cmdOffset + &H0555, &HAA)
		DumperFlashConfig(.cmdList[1], cmdOffset + &H02AA, &H55)
		DumperFlashConfig(.cmdList[2], cmdOffset + &H0555, &HA0)
	End With
	DatabusFlashConfig(hCOM, VarPtr(FlashConfig16bit))

End Sub

Function FlashWriteHardware(cmdBase As DWord, buf As *BufferClass, mmodel As *SFC_MMAP_MODEL, pc AS *DumpRomProgressCallBack) As BOOL
	If mmodel->rom.init_cb Then mmodel->rom.init_cb(hCOM)

	Dim bus_addr AS DWord, last_bank AS DWord
	bus_addr = mmodel->rom.next_cb(hCOM, cmdBase, 0)
	last_bank = &HFFFFFFFF


	Const FLASH_WRITE_BUF_SIZE = &H4000
	Dim img_offset=0 AS DWord
	Dim block_size=FLASH_WRITE_BUF_SIZE AS DWord

	Dim i as DWord, start AS DWord
	start = GetTickCount()
	Do
		if last_bank <> (bus_addr>>16) then
			UpdateFlashConfig(bus_addr)
			last_bank = (bus_addr>>16)
		endif

		Dim dur_ms AS DWord, speed AS Single
		dur_ms = (GetTickCount() - start)
		if dur_ms = 0 then dur_ms++
		speed = (img_offset AS Single) / (dur_ms)
		DBMf("%X: %Xh/%Xh %d.%ds %d.%dKB/s", bus_addr, img_offset, buf->length(), dur_ms/1000, dur_ms/100 Mod 10,speed AS DWord, (speed * 10) AS DWord Mod 10)
		PumpMessage()
				
		if DatabusFlashWrite(hCOM, buf->ptr + img_offset, 0, bus_addr, block_size, FALSE) = FALSE Then
			FlashWaitOperationHW(-1, 2000)
			DBM("failed to program ROM.")
			ExitDo
		End If
		img_offset += block_size
		
		pc->Step(FLASH_WRITE_BUF_SIZE AS Long, img_offset)

		if (buf->length() - img_offset) > FLASH_WRITE_BUF_SIZE then
			block_size = FLASH_WRITE_BUF_SIZE
		Else
			block_size = buf->length() - img_offset
			if block_size = 0 then 
				FlashWriteHardware = TRUE
				ExitDo
			End If
		endif
		bus_addr = mmodel->rom.next_cb(hCOM, bus_addr, block_size)
		i++
	Loop

	If mmodel->rom.exit_cb Then mmodel->rom.exit_cb(hCOM, NULL)
End Function

Sub FlashWnd_CommandButton2_Click()
	FlashCmdInit(cmdBank, cmdOffset)
	FlashCmdChipErase(cmdBank, cmdOffset)
	FlashCmdExit(cmdBank, cmdOffset)
End Sub

Sub FlashWnd_Program(file AS BytePtr)
	Dim mapMode AS Long
	Dim mmap As SFC_MMAP_MODEL
	mapMode = getSelectedMapMode()
	GetMmapModel(mapMode, TRUE, VarPtr(mmap)) ' TODO

	Dim buf AS BufferClass

	if LoadFileToMemory(file, VarPtr(buf)) = FALSE then
		DBM("failed to load file.")
		exitsub
	endif
	if buf.length() = 0 then
		DBM("file size is zero.")
		exitsub
	endif

	Dim pc AS *DumpRomProgressCallBack
	pc = new_DumpRomProgressCallBack()
	pc->Init(buf.length())

	FlashCmdInit(cmdBank, cmdOffset)
	
'	FlashWriteSoftware(VarPtr(buf), pc)
	FlashWriteHardware(cmdBank<<16 + cmdOffset, VarPtr(buf), VarPtr(mmap), pc)

	FlashCmdExit(cmdBank, cmdOffset)
	DBM("program exit.")
	
	pc->Final()

	delete_DumpRomProgressCallBack(pc)
End Sub

Sub FlashWnd_CommandButton4_Click()
	Dim path As BytePtr

	path = LoadDialogCalloc(ex"ROMイメージファイル(*.sfc)\0*.sfc\0すべてのファイル(*.*)\0*.*\0\0", "sfc")
	If path=0 Then ExitSub
	FlashWnd_Program(path)
	free(path)
End Sub

Sub FlashWnd_CommandButton3_Click()
	FlashWnd_Program("write2.srm")
End Sub

