' ============ defines and datas ==========

Type FlashCmdList
	count AS Long
	elm[ELM(10)] AS FlashCmdElm
End Type

Type FlashCmdSet
	name AS BytePtr
	detect AS FlashCmdList
	chipErase AS FlashCmdList
	program As FlashCmdList
	reset As FlashCmdList
End Type

Enum FlashCmdType
	FlashCmdTypeJDEC8 = 0
	FlashCmdTypeJDEC16Shift8
	FlashCmdTypeMAX
	FlashCmdTypeNotFlash
End Enum

Function GetFlashCmdSet(flashType As FlashCmdType, ByRef set AS FlashCmdSet) AS BOOL
	GetFlashCmdSet = TRUE

	Select Case flashType
		Case FlashCmdTypeNotFlash
			set.name = "< not flash chip >"
			set.detect.count = 0
			set.chipErase.count = 0
			set.program.count = 0
			set.reset.count = 0
		Case FlashCmdTypeJDEC8
			set.name = "JDEC Standard 8bit (A14)"
			With set.detect
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &H90)
			End With
			With set.chipErase
				.count = 6
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &H80)

				FLASH_CMD(.elm[3], &H5555, &HAA)
				FLASH_CMD(.elm[4], &H2AAA, &H55)
				FLASH_CMD(.elm[5], &H5555, &H10)
			End With
			With set.program
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &HA0)
			End With
			With set.reset
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &HF0)
			End With

		' 8/16bit Flash eg: MX29F800
		Case FlashCmdTypeJDEC16Shift8
			set.name = "JDEC Standard 8/16bit (8bit mode)"
			With set.detect
				.count = 3
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &H90)
			End With
			With set.chipErase
				.count = 6
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &H80)

				FLASH_CMD(.elm[3], &H2AAA, &HAA)
				FLASH_CMD(.elm[4], &H5555, &H55)
				FLASH_CMD(.elm[5], &H2AAA, &H10)
			End With
			With set.program
				.count = 3
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &HA0)
			End With
			With set.reset
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &HF0)
			End With
		Case Else
			GetFlashCmdSet = FALSE
	End Select
End Function


Type FlashChipInfo
	id AS DWord
	name AS BytePtr
	size AS DWord
End Type

Const FLASH_ID_TABLE_MAX = 30
Const MBIT(x) = (x * &H20000)
Dim FlashChipInfoTable[ELM(FLASH_ID_TABLE_MAX)] = [
	[ &HC2A4, "MX29F040"   , MBIT( 4) ], ' [TESTED]
	[ &HC2D5, "MX29F080"   , MBIT( 8) ], ' ByteProgram: 7-210us, ChipErase: 8-64sec
	[ &HC2D6, "MX29F800CT" , MBIT( 8) ], ' 
	[ &HC258, "MX29F800CB" , MBIT( 8) ], ' 
	[ &HC249, "MX29LV160DB", MBIT(16) ],
	[ &HC2C4, "MX29LV160DT", MBIT(16) ],
	[ &HC2A8, "MX29LV320DB", MBIT(32) ],
	[ &HC2A7, "MX29LV320DT", MBIT(32) ],
	[ &HC2CB, "MX29LV640DB", MBIT(64) ],
	[ &HC2C9, "MX29LV640DT", MBIT(64) ],
	[ &HC2FA, "MX29F1610A" , MBIT(16) ], ' NintendoPower
	[ &HC2FB, "MX29F1610B" , MBIT(16) ], ' NintendoPower
	[ &HC2F7, "MX29F1611"  , MBIT(16) ], ' NintendoPower
	[ &HC26B, "MX29F1615"  , MBIT(16) ], ' NintendoPower
	[ &HC2F3, "MX29F1601MC", MBIT(16) ], ' NintendoPower
	[ &H01A4, "AM29F040"   , MBIT( 4) ], ' ByteProgram: 7-300us, 8-64sec
	[ &H01D5, "AM29F080"   , MBIT( 8) ],
	[ &HBFB5, "SST39SF010A", MBIT( 1) ],
