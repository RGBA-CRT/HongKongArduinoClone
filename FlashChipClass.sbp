' ============ defines and datas ==========

Type FlashCmdList
	count AS Long
	elm[ELM(10)] AS FlashCmdElm
End Type

Type FlashCmdSet
	name AS BytePtr
	detect AS FlashCmdList
	chipErase AS FlashCmdList
	program As FlashCmdList
	reset As FlashCmdList
End Type

Enum FlashCmdType
	FlashCmdTypeNotFlash = 0
	FlashCmdTypeJDEC8
	FlashCmdTypeJDEC16Shift8
	FlashCmdTypeMX29F1610
	FlashCmdTypeFastDetect
	FlashCmdTypeFastDetect2
	FlashCmdTypeS29GL032N
	FlashCmdTypeMAX
End Enum

Sub FLASH_CMD(ByRef elm as FlashCmdElm,adr AS Word, data as Byte)
	elm.address = adr
	elm.data = data
End Sub
Function GetFlashCmdSet(flashType As FlashCmdType, ByRef set AS FlashCmdSet) AS BOOL
	GetFlashCmdSet = TRUE

	Select Case flashType
		Case FlashCmdTypeNotFlash
			set.name = "< not flash chip >"
			set.detect.count = 0
			set.chipErase.count = 0
			set.program.count = 0
			set.reset.count = 0
			
		Case FlashCmdTypeJDEC8
			set.name = "JDEC Standard 8bit (A14)"
			With set.detect
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &H90)
			End With
			With set.chipErase
				.count = 6
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &H80)

				FLASH_CMD(.elm[3], &H5555, &HAA)
				FLASH_CMD(.elm[4], &H2AAA, &H55)
				FLASH_CMD(.elm[5], &H5555, &H10)
			End With
			With set.program
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &HA0)
			End With
			With set.reset
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &HF0)
			End With

		' 8/16bit Flash eg: MX29F800
		Case FlashCmdTypeJDEC16Shift8
			set.name = "JDEC Standard 8/16bit (8bit mode)"
			With set.detect
				.count = 3
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &H90)
			End With
			With set.chipErase
				.count = 6
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &H80)

				FLASH_CMD(.elm[3], &H2AAA, &HAA)
				FLASH_CMD(.elm[4], &H5555, &H55)
				FLASH_CMD(.elm[5], &H2AAA, &H10)
			End With
			With set.program
				.count = 3
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &HA0)
			End With
			With set.reset
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &HF0)
			End With

			
		Case FlashCmdTypeMX29F1610
			set.name = "[TEST] Long Reset"
			With set.detect
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &H90)
			End With
			With set.chipErase
				.count = 6
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &H80)

				FLASH_CMD(.elm[3], &H5555, &HAA)
				FLASH_CMD(.elm[4], &H2AAA, &H55)
				FLASH_CMD(.elm[5], &H5555, &H10)
			End With
			With set.program
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &HA0)
			End With
			With set.reset
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &HF0)
			End With
		Case FlashCmdTypeFastDetect
			set.name = "[TEST] Detect write adr 0"
			With set.detect
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &H90)
			End With
			With set.chipErase
				.count = 6
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &H80)

				FLASH_CMD(.elm[3], &H5555, &HAA)
				FLASH_CMD(.elm[4], &H2AAA, &H55)
				FLASH_CMD(.elm[5], &H5555, &H10)
			End With
			With set.program
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &HA0)
			End With
			With set.reset
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &HF0)
			End With
		Case FlashCmdTypeFastDetect2
			set.name = "[TEST] Detect write adr 0 and lonreset"
			With set.detect
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &H90)
			End With
			With set.chipErase
				.count = 6
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &H80)

				FLASH_CMD(.elm[3], &H5555, &HAA)
				FLASH_CMD(.elm[4], &H2AAA, &H55)
				FLASH_CMD(.elm[5], &H5555, &H10)
			End With
			With set.program
				.count = 3
				FLASH_CMD(.elm[0], &H5555, &HAA)
				FLASH_CMD(.elm[1], &H2AAA, &H55)
				FLASH_CMD(.elm[2], &H5555, &HA0)
			End With
			With set.reset
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &HF0)
			End With

		Case FlashCmdTypeS29GL032N
			set.name = "Spansion with word write (8bit mode)"
			With set.detect
				.count = 3
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &H90)
			End With
			With set.chipErase
				.count = 6
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &H80)

				FLASH_CMD(.elm[3], &H2AAA, &HAA)
				FLASH_CMD(.elm[4], &H5555, &H55)
				FLASH_CMD(.elm[5], &H2AAA, &H10)
			End With
			With set.program
				.count = 3
				FLASH_CMD(.elm[0], &H2AAA, &HAA)
				FLASH_CMD(.elm[1], &H5555, &H55)
				FLASH_CMD(.elm[2], &H2AAA, &HA0)
			End With
			With set.reset
				.count = 1
				FLASH_CMD(.elm[0], &H0000, &HF0)
			End With
		Case Else
			GetFlashCmdSet = FALSE
	End Select
End Function


Type FlashChipInfo
	id AS DWord
	name AS BytePtr
	size AS DWord
End Type

