' うまく書き込めないときはPLCCソケットの接触を確認しよう

Type FlashChipId
	idSize AS Long
	vendor AS Word
	product AS Word
	extend AS DWord
End Type

' ========== implments =============

Const EON_FLASH_ID_OFFSET = &H100 ' EONのFlashはオフセットかけないと7F 7Fが帰る変な仕様
Const FLASH_ID_SIZE = 64
Const FLASH_ID_OFFSET = EON_FLASH_ID_OFFSET
const FLASH_ERASE_TIMEOUT_MS = 130000 ' MAX: EN29F002 35sec -> S29GL064 128sec
Const PollInterval=32
' logic
Class FlashChipController
Private
	hSerial AS HANDLE
	flashType AS FlashCmdType
	cmdSet AS FlashCmdSet
	baseBusAdr AS DWord
	isSwapCE_OE AS BOOL

Public
	Sub Init(com_handle AS HANDLE, flashType AS FlashCmdType, base AS DWord, swapCE_OE AS BOOL)
		if GetFlashCmdSet(flashType, cmdSet) = FALSE then
			flashType = FlashCmdTypeNotFlash
			ExitSub
		End If
		this.hSerial = com_handle
		this.flashType = flashType
		this.baseBusAdr = base
		this.isSwapCE_OE = swapCE_OE
	End Sub

	Function GetFlashChipId(id As *FlashChipId) AS BOOL		
		if flashType = FlashCmdTypeNotFlash Then
			ExitFunction 
		End If

		Dim flashIdBuf[FLASH_ID_SIZE] AS Byte
		if ReadFlashChipId(flashIdBuf) = FALSE then
			ExitFunction
		End If

		if id then 
			' todo move this
			if flashType = FlashCmdTypeJDEC16Shift8 then
				id->idSize = 1
				id->vendor = flashIdBuf[0]
				id->product = flashIdBuf[2]
				id->extend = 0
				if id->vendor = id->product then ExitFunction
				if (id->vendor = &H01) And (id->product = &H7E) then ExitFunction ' Skip to FlashCmdTypeS29GL032N

			Elseif flashType = FlashCmdTypeS29GL032N then
				id->idSize = 1
				id->vendor = flashIdBuf[0]
				id->product = flashIdBuf[2]
				id->extend = (flashIdBuf[&H1C]<<8) OR (flashIdBuf[&H1E])
				if id->vendor = id->product then ExitFunction

			Else
				id->idSize = 1
				id->vendor = flashIdBuf[0]
				id->product = flashIdBuf[1]
				id->extend = 0
				if id->vendor = id->product then ExitFunction
			endif
		End If
		GetFlashChipId = TRUE
	End Function

	Function ChipErase(pc AS *ProgressCallBack) AS BOOL
		FlushCom(hSerial)
		EnterCommandMode()
		DoFlashCmd(VarPtr(cmdSet.chipErase()))

		if pc then pc->Init(FLASH_ERASE_TIMEOUT_MS AS DWord)
		ChipErase = FlashWaitOperation(baseBusAdr, &HFF, FLASH_ERASE_TIMEOUT_MS, pc/*, TRUE*/)
		if pc then pc->Final()

		ExitCommandMode()
	End Function

	Function Program(buf AS BytePtr, bufsize AS DWord, mmodel AS *SFC_MMAP_MODEL, pc AS *ProgressCallBack) AS BOOL
		FlushCom(hSerial)
		EnterCommandMode()

		If mmodel->rom.init_cb Then mmodel->rom.init_cb(hCOM)

		Dim bus_addr AS DWord, last_bank AS DWord
		bus_addr = mmodel->rom.next_cb(hCOM, baseBusAdr, 0)
		last_bank = &HFFFFFFFF

		Const FLASH_WRITE_BUF_SIZE = &H4000
		Dim img_offset=0 AS DWord
		Dim block_size=FLASH_WRITE_BUF_SIZE AS DWord

		Dim i as DWord, start AS DWord
		start = GetTickCount()
		Do
			if last_bank <> (bus_addr>>16) then
				UpdateFlashConfig(bus_addr, isSwapCE_OE)
				last_bank = (bus_addr>>16)
			endif

			Dim dur_ms AS DWord, speed AS Single
			dur_ms = (GetTickCount() - start)
			if dur_ms = 0 then dur_ms++
			speed = (img_offset AS Single) / (dur_ms)
			DBMf("%Xh %d/%d %d.%ds %d.%dKB/s", _
				bus_addr, _
				img_offset/1024, bufsize/1024, _
				dur_ms/1000, dur_ms/100 Mod 10,speed AS DWord, (speed * 10) AS DWord Mod 10)
					
			if DatabusFlashWrite(hCOM, buf + img_offset, 0, bus_addr, block_size, FALSE) = FALSE Then
				FlashWaitOperation(bus_addr, -1, 2000, NULL)
				DBM("failed to program ROM.")
				ExitDo
			End If
			img_offset += block_size
			
			if pc then 
				pc->Step(FLASH_WRITE_BUF_SIZE AS Long, img_offset)
				if pc->isCancel() then
					DBM("Aborted by user")
					Exitdo
				End If
			End If

			if (bufsize - img_offset) > FLASH_WRITE_BUF_SIZE then
				block_size = FLASH_WRITE_BUF_SIZE
			Else
				block_size = bufsize - img_offset
				if block_size = 0 then 
					Program = TRUE
					ExitDo
				End If
			endif

			' LoROMバンク跨ぎ防止
			printf(ex"%xh - %x %d %xh\n", bus_addr, bus_addr+block_size-1, block_size,block_size)
			if ((bus_addr And &H7FFF) + block_size) > &H8000 then
				debug
				block_size = &H8000 - (bus_addr And &H7FFF)
			endif
			bus_addr = mmodel->rom.next_cb(hCOM, bus_addr, block_size)
			i++
		Loop

		If mmodel->rom.exit_cb Then mmodel->rom.exit_cb(hCOM, NULL)

		ExitCommandMode()
	End Function

	Sub CfiDump()
		Dim cmd As FlashCmdList
		cmd.count = &H1
		FLASH_CMD(cmd.elm[0], &HAA, &H98)
		
		EnterCommandMode()
		DoFlashCmd(VarPtr(cmd))

		Dim buf[&H100] AS Byte
		ReadROM(hSerial, buf, 0, baseBusAdr + &H20, &H100, FALSE)
		Dump(buf, &H100)

		ExitCommandMode()
	End Sub

	Sub TestSectorUnprotect()
		Dim cmd As FlashCmdList
		cmd.count = &H1
		FLASH_CMD(cmd.elm[0], &HAA, &H60)
		
		EnterCommandMode()
		BusFlashCmd(baseBusAdr + 0, &H60)
		BusFlashCmd(baseBusAdr + &He000 + &H4, &H60)
		Sleep(1)
		BusFlashCmd(baseBusAdr + &He000 + &H4, &H40)

		Dim buf[&H100] AS Byte
		ReadROM(hSerial, buf, 0, baseBusAdr + &He000 + &H24, &H100, FALSE)
		Dump(buf, &H100)

		ExitCommandMode()
	End Sub

	Sub MX29LV320_SectorProtectDump(size AS DWord, mmodel AS *SFC_MMAP_MODEL, pc AS *ProgressCallBack)
		Dim flashIdBuf[FLASH_ID_SIZE] AS Byte
		Dim SECTOR_SIZE = 8*1024 AS DWord
		Dim i AS Long
'		Dim lastTs AS DWord

		if pc then pc->Init(size)
		Do 
			Dim bus_addr, flash_ofs AS DWord
			flash_ofs = i*SECTOR_SIZE
			bus_addr = baseBusAdr + FLASH_ID_OFFSET + flash_ofs

			EnterCommandMode()
			DoFlashCmd(VarPtr(cmdSet.detect()))
			ReadROM(hSerial,(flashIdBuf),0,bus_addr,FLASH_ID_SIZE,FALSE)
			ExitCommandMode()

			logger(ex"SectorProtectCheck %x: %x-%x %02x %02x\n", bus_addr, flash_ofs, flash_ofs + SECTOR_SIZE-1, flashIdBuf[&H4], flashIdBuf[&H6])
			if flashIdBuf[4] = 0 then
				' do nothing
			Elseif flashIdBuf[4] = 1 then
				DBMf(ex"\nProtected %x: %x-%x %02x %02x\n", bus_addr, flash_ofs, flash_ofs + SECTOR_SIZE-1, flashIdBuf[&H4], flashIdBuf[&H6])
			Else
				DBMf(ex"\nInvalid protect status? %x: %x-%x %02x %02x\n", bus_addr, flash_ofs, flash_ofs + SECTOR_SIZE-1, flashIdBuf[&H4], flashIdBuf[&H6])
			endif
			
			if pc then 
				'if GetTickCount()-lastTs > 250 then
					pc->Step(SECTOR_SIZE AS Long, (i*SECTOR_SIZE))
					if pc->isCancel() then
						DBM("Aborted by user")
						Exitdo
					End If
				'	lastTs = GetTickCount()
				'End If
			endif
			i++
			if size <= (i*SECTOR_SIZE) then exitdo
		Loop

		if pc then pc->Final()
	End Sub
Private
	

	Function ReadFlashChipId(ByRef flashIdBuf[FLASH_ID_SIZE] AS Byte) AS BOOL
		Dim preId[ELM(FLASH_ID_SIZE)] As Byte
		FlushCom(hSerial)
		ReadROM(hSerial,VarPtr(preId),0,baseBusAdr + FLASH_ID_OFFSET,FLASH_ID_SIZE,FALSE)

		EnterCommandMode()
		DoFlashCmd(VarPtr(cmdSet.detect()))

		ReadROM(hSerial,VarPtr(flashIdBuf),0,baseBusAdr + FLASH_ID_OFFSET,FLASH_ID_SIZE,FALSE)
		logger(ex"preid\n")
		DumpHKAC(VarPtr(preId),64,0)
		logger(ex"flash id\n")
		DumpHKAC(VarPtr(flashIdBuf),64,0,TRUE)
		
		ExitCommandMode()
		/*
		 pre    id
		0rand 0rand .. OK
		0rand 1flat .. NG
		1flat 0rand .. OK
		1flat 1flat .. NG
		*/

		if memcmp(preId, flashIdBuf, FLASH_ID_SIZE) <> 0 then
			Dim preCheck AS BOOL, idCheck AS BOOL
			preCheck = FillCheck(preId, preId[0], FLASH_ID_SIZE)
			idCheck  = FillCheck(flashIdBuf, flashIdBuf[0], FLASH_ID_SIZE)
			if (idCheck = FALSE)  then
				ReadFlashChipId = TRUE
			End If
			logger(ex"busOpenCheck IsFill pre=%d, id=%d. IsFlashId=%d\n", preCheck, idCheck, ReadFlashChipId)
		Else
			logger(ex"busOpenCheck pre, id bin match. not FlashID.\n")
		Endif

	End Function

	Function FillCheck(buf AS BytePtr, c as Byte, size AS Long) AS BOOL
		Dim i = 0 AS Long
		FillCheck=TRUE
		do
			if i >= size then ExitDo
			if buf[i] <> c then
				FillCheck = FALSE
				ExitDo
			End If
			i++
		Loop
	End Function

	Function AdrBank(adr AS DWord) As Byte
		AdrBank = (adr>>16) AS Byte
	End Function
	Function AdrOfs(adr AS DWord) As DWord
		AdrOfs = adr And &HFFFF
	End Function

	Sub BusFlashCmd(adr AS DWord, data As DWord)
		' todo: MapModelを考慮する。いまのところFlashCmdは8000h境界をまたがないので問題ないが。
		SetCartRegister( AdrBank(baseBusAdr), AdrOfs(baseBusAdr) + adr, data AS Byte, FALSE)
	End Sub

	Sub DoFlashCmd(cmdList AS *FlashCmdList)
		dim i =0 As DWord
		Do
			if i => cmdList->count then ExitDo
			BusFlashCmd(cmdList->elm[i].address, cmdList->elm[i].data)
			i++
		Loop
	End Sub

	Sub EnterCommandMode()
		UpdateFlashConfig(this.baseBusAdr, this.isSwapCE_OE)
		SendControl(hSerial, CBUS_OE OR CBUS_ROMSEL OR CBUS_WE)
		SendControl(hSerial, CBUS_OE OR CBUS_WE OR CBUS_RST)

		' Reset Flash
		DoFlashCmd(VarPtr(cmdSet.reset))
	End Sub

	Sub ExitCommandMode()
		' Reset Flash
		DoFlashCmd(VarPtr(cmdSet.reset))
		SendControl(hSerial, CBUS_DEFAULT)

		UpdateFlashConfig(this.baseBusAdr, FALSE)
	End Sub


	Sub UpdateFlashConfig(cmdBase As DWord, swapCEOE AS BOOL)
		Dim cmdOffset AS Word
		cmdOffset = AdrOfs(baseBusAdr)
		Dim FlashConfig16bit AS FlashConfig		
		dim i =0 As DWord
		
		With FlashConfig16bit
			.bank = AdrBank(baseBusAdr)
			Do
				if i => cmdSet.program.count then ExitDo
				if i => FLASH_CMD_LIST_LEN then 
					ErrMes(hMainWnd, "ASSERT!!: Flash program cmd length is too long", 0, 0)
					ExitDo
				End If
				.cmdList[i].address = cmdOffset + cmdSet.program.elm[i].address
				.cmdList[i].data = cmdOffset + cmdSet.program.elm[i].data
				i++
			Loop
			if swapCEOE then
				.flags = FLASH_CONFIG_CEOE_SWAP
			Else
				.flags = 0
			endif
		End With

		DatabusFlashConfig(hSerial, VarPtr(FlashConfig16bit))
	End Sub

	Function FlashWaitOperation(offset As DWord, expect AS Long, timeout_ms As DWord, pc AS *ProgressCallBack)(swMode AS BOOL) AS BOOL
		Dim i as Long, start AS DWord, lastDur AS DWord
		start = GetTickCount()
		Do
			Dim poll AS Byte

			if swMode then
				ReadROM(hSerial, VarPtr(poll), 0, baseBusAdr + offset, 1, FALSE)
			Else
				poll = DatabusRead(hSerial)
			End If
			logger(ex"[FlashPoll] value=%02X, expected=%02X, inv=%d, tgl=%d,%d, DQ5Fail=%d, DQ3=%d, dur=%dms\n", _
				poll, expect, _
				(poll>>7) And 1, (poll>>6) And 1, (poll>>2) And 1, (poll>>5) And 1, (poll>>3) And 1, _
				GetTickCount() - start)

	'		SendControl(hSerial, CBUS_OE OR CBUS_WE OR CBUS_RST)		

			if expect > 0 then
				if poll = expect then
					FlashWaitOperation = TRUE
					ExitDo
				End If
			End If

			dim dur AS DWord
			dur = (GetTickCount() - start)
			if dur > timeout_ms then
				ExitDo
			End If
			if pc then
				pc->Step(dur - lastDur, dur)
				lastDur = dur
				if pc->isCancel() then
					logger(ex"user cancelled.\n")
					Exitdo
				Endif
			End If
			Sleep(PollInterval)
			i++
		Loop

	End Function

	
End Class

