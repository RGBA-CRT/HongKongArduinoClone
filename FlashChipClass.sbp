Function GetFlashChipInfo(chipId AS *FlashChipId) As *FlashChipInfo
	Dim i As Long
	GetFlashChipInfo = NULL
	if chipId->idSize = 1 then
		Dim id AS Word
		id = (chipId->vendor << 8) OR (chipId->product)
		for i = 0 To FLASH_ID_TABLE_MAX-1
			if FlashChipInfoTable[i].id = id Then
				GetFlashChipInfo = VarPtr(FlashChipInfoTable[i])
				ExitFor
			End If
		Next
	End If
End Function

' retrn: FlashCmdType
Function FlashDetect(hSerial As HANDLE, base AS DWord, flashId AS *FlashChipId) AS Long
	FlashDetect = FlashCmdTypeNotFlash
	Dim fc AS FlashChipController
	Dim i aS Long
	For i = 0 To FlashCmdTypeMAX-1
		fc.Init(hSerial, i As FlashCmdType, base)
		if fc.GetFlashChipId(flashId) then
			FlashDetect = i
			ExitFunction
		End If
	Next
End Function

