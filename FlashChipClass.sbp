Function GetFlashChipInfo(chipId AS *FlashChipId) As *FlashChipInfo
	Dim i As Long
	Dim id AS DWord
	
	GetFlashChipInfo = NULL
	if chipId->idSize = 1 then
		id = (chipId->vendor << 8) OR (chipId->product) OR (chipId->extend << 16)

		for i = 0 To FLASH_ID_TABLE_MAX-1
			if FlashChipInfoTable[i].id = id Then
				GetFlashChipInfo = VarPtr(FlashChipInfoTable[i])
				ExitFor
			End If
		Next
	End If
End Function

' retrn: FlashCmdType
Function FlashDetect(hSerial As HANDLE, base AS DWord, flashId AS *FlashChipId, isSwapCEOE AS *BOOL) AS Long
	FlashDetect = FlashCmdTypeNotFlash	
	if isSwapCEOE = NULL then exitFunction

	Dim ret AS Long
	logger(ex"[DETECT][L1] Try OE/CE swap mode...\n")
	ret = FlashDetect_(hSerial, base, flashId, TRUE)
	if ret = FlashCmdTypeNotFlash then
		logger(ex"[DETECT][L1] Try OE/CE non-swap mode...\n")
		ret = FlashDetect_(hSerial, base, flashId, FALSE)
		SetDWord(isSwapCEOE, FALSE)
	Else
		SetDWord(isSwapCEOE, TRUE)
	endif
	FlashDetect = ret
End Function

Function FlashDetect_(hSerial As HANDLE, base AS DWord, flashId AS *FlashChipId, isSwapCEOE AS BOOL) AS Long
	FlashDetect_ = FlashCmdTypeNotFlash
	Dim fc AS FlashChipController
	Dim i aS Long
	For i = 1 To FlashCmdTypeMAX-1
		logger(ex"[DETECT][L2] Try FlashType=%d...\n", i)
		fc.Init(hSerial, i As FlashCmdType, base, isSwapCEOE)
		if fc.GetFlashChipId(flashId) then
			FlashDetect_ = i
			fc.CfiDump()
			ExitFunction
		End If
	Next
End Function

